            {
                "box": {
                    "code": "// Highlight the actived panel\r\nconst panels = [\"panel-1\", \"panel-2\", \"panel-3\", \"panel-4\", \"panel-5\", \"panel-6\", \"panel-7\", \"panel-8\"];\nfunction msg_int(val) {\n  const target = panels.at(val);\r\n  patcher.message(\"script\", \"send\", target, \"bgfillcolor\", [0.8, 0.8, 0.1, 1]);\n  panels\n    .filter((_, i) => i !== val)\n    .forEach((e) => {\n      patcher.message(\"script\", \"send\", e, \"bgfillcolor\", [0.2, 0.2, 0.2, 1]);\n    });\n}\r\n ",
                    "filename": "none",
